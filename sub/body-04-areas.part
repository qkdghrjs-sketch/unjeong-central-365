<div id="eumSub">

  <!-- ═══════════ 서브 히어로 ═══════════ -->
  <section class="eum_hero">
    <div class="eum_wrap">
      <span class="eum_eyebrow eum_rv"><span class="eum_bar"></span>ACCESS GUIDE · 지역별 오시는 길</span>
      <h1 class="eum_h1 eum_rv eum_d1">일산에서 지하철로<br><em>5분에서 14분</em></h1>
      <p class="eum_hsub eum_rv eum_d2">이움내과의원은 고양시 덕양구 화정동에 있습니다.<br>지하철 3호선 화정역이 일산과 직결되어, 백석 2정거장·마두 3정거장·주엽 5정거장이면 도착합니다.</p>
      <div class="eum_badges eum_rv eum_d3">
        <span class="eum_badge"><span class="eum_dot"></span>3호선 화정역 도보 5분</span>
        <span class="eum_badge"><span class="eum_dot"></span>환승 없이 일산 직결</span>
        <span class="eum_badge"><span class="eum_dot"></span>주차 무료</span>
        <span class="eum_badge"><span class="eum_dot"></span>야간투석 운영</span>
      </div>
    </div>
  </section>

  <!-- ═══════════ 핵심 답변 ═══════════ -->
  <section class="eum_sec">
    <div class="eum_wrap">
      <div class="eum_key eum_rv">
        <span class="eum_q">Q. 일산에서 다닐 만한 내과·신장내과를 찾고 있습니다. 이움내과의원까지 얼마나 걸리나요?</span>
        <p><strong>이움내과의원은 경기 고양시 덕양구 백양로 51 네이버타운 3층</strong>에 있으며, 행정구역상 일산동구·일산서구가 아닌 <strong>덕양구 화정동</strong>입니다. 다만 지하철 3호선 화정역이 일산과 직결되어 있어 실제 이동 시간은 짧습니다.</p>
        <p>백석역에서 2정거장(약 5분), 마두역에서 3정거장(약 7분), 정발산역에서 4정거장(약 9분), 주엽역에서 5정거장(약 11분), 대화역에서 6정거장(약 14분)이며 <strong>모두 환승 없이</strong> 오실 수 있습니다. 화정역 1번 출구에서 병원까지는 도보 약 5분입니다.</p>
        <div class="eum_facts">
          <span class="eum_fact"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>3호선 화정역 1번 출구 도보 5분</span>
          <span class="eum_fact"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>백석역 2정거장 · 마두역 3정거장</span>
          <span class="eum_fact"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>주엽역 5정거장 · 대화역 6정거장</span>
          <span class="eum_fact"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>네이버타운 주차장 무료</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════ 일산 ═══════════ -->
  <section class="eum_sec eum_alt">
    <div class="eum_wrap">
      <div class="eum_shead eum_rv">
        <span class="eum_eyebrow"><span class="eum_bar"></span>FROM ILSAN</span>
        <h2 class="eum_h2">일산에서 오시는 길</h2>
        <p class="eum_lead">3호선 한 번으로 환승 없이 오실 수 있습니다.</p>
      </div>
      <div class="eum_areas">
        <div class="eum_area eum_rv">
          <b>백석동</b>
          <span class="eum_ad">고양시 일산동구</span>
          <div class="eum_ats"><span class="eum_at"><em>지하철</em>약 5분 <em>(2정거장)</em></span><span class="eum_at"><em>자가용</em>약 10분</span></div>
          <span class="eum_ar">3호선 백석역에서 화정역까지 두 정거장, 환승 없이 직결됩니다.</span>
        </div>
        <div class="eum_area eum_rv eum_d2">
          <b>마두동</b>
          <span class="eum_ad">고양시 일산동구</span>
          <div class="eum_ats"><span class="eum_at"><em>지하철</em>약 7분 <em>(3정거장)</em></span><span class="eum_at"><em>자가용</em>약 12분</span></div>
          <span class="eum_ar">3호선 마두역에서 화정역까지 세 정거장입니다. 일산동구에서 가장 접근이 쉬운 편입니다.</span>
        </div>
        <div class="eum_area eum_rv eum_d3">
          <b>장항동 · 정발산</b>
          <span class="eum_ad">고양시 일산동구</span>
          <div class="eum_ats"><span class="eum_at"><em>지하철</em>약 9분 <em>(4정거장)</em></span><span class="eum_at"><em>자가용</em>약 15분</span></div>
          <span class="eum_ar">3호선 정발산역에서 화정역까지 네 정거장입니다. 일산 라페스타·웨스턴돔 일대에서 오시기 좋습니다.</span>
        </div>
        <div class="eum_area eum_rv eum_d4">
          <b>주엽동</b>
          <span class="eum_ad">고양시 일산서구</span>
          <div class="eum_ats"><span class="eum_at"><em>지하철</em>약 11분 <em>(5정거장)</em></span><span class="eum_at"><em>자가용</em>약 18분</span></div>
          <span class="eum_ar">3호선 주엽역에서 화정역까지 다섯 정거장, 환승 없이 이동합니다.</span>
        </div>
        <div class="eum_area eum_rv eum_d4">
          <b>대화동</b>
          <span class="eum_ad">고양시 일산서구</span>
          <div class="eum_ats"><span class="eum_at"><em>지하철</em>약 14분 <em>(6정거장)</em></span><span class="eum_at"><em>자가용</em>약 22분</span></div>
          <span class="eum_ar">3호선 종착역인 대화역에서 화정역까지 여섯 정거장입니다. 앉아서 오실 수 있습니다.</span>
        </div>
        <div class="eum_area eum_rv eum_d4">
          <b>탄현동</b>
          <span class="eum_ad">고양시 일산서구</span>
          <div class="eum_ats"><span class="eum_at"><em>지하철</em>약 20분</span><span class="eum_at"><em>자가용</em>약 22분</span></div>
          <span class="eum_ar">경의중앙선 탄현역에서 대곡역 환승 후 3호선으로 화정역까지 한 정거장입니다.</span>
        </div>
      </div>
      <div class="eum_notebox eum_rv" style="margin-top:32px">
        <p><strong>일산에서 특히 많이 찾으시는 이유</strong></p>
        <p>고양시 일산 지역에는 <strong>야간 혈액투석을 운영하는 의원이 드뭅니다.</strong> 이움내과의원은 월·수·금 저녁 6시부터 밤 10시 30분까지 야간투석을 운영하고 있어, 낮에 일하시는 분들이 일산에서 3호선을 타고 오시는 경우가 많습니다.</p>
      </div>
    </div>
  </section>

  <!-- ═══════════ 덕양구 ═══════════ -->
  <section class="eum_sec">
    <div class="eum_wrap">
      <div class="eum_shead eum_rv">
        <span class="eum_eyebrow"><span class="eum_bar"></span>FROM DEOKYANG-GU</span>
        <h2 class="eum_h2">덕양구에서 오시는 길</h2>
        <p class="eum_lead">화정 생활권은 도보로, 그 외 지역은 3호선 한두 정거장입니다.</p>
      </div>
      <div class="eum_areas">
        <div class="eum_area eum_rv">
          <b>화정동</b>
          <span class="eum_ad">고양시 덕양구</span>
          <div class="eum_ats"><span class="eum_at"><em>지하철</em>도보 약 5분 <em>(0정거장)</em></span><span class="eum_at"><em>자가용</em>약 5분</span></div>
          <span class="eum_ar">화정역 1번 출구에서 백양로 방향으로 도보 약 5분입니다. 화정 로데오거리 생활권 어디서든 걸어서 오실 수 있습니다.</span>
        </div>
        <div class="eum_area eum_rv eum_d2">
          <b>원당동 · 성사동</b>
          <span class="eum_ad">고양시 덕양구</span>
          <div class="eum_ats"><span class="eum_at"><em>지하철</em>약 3분 <em>(1정거장)</em></span><span class="eum_at"><em>자가용</em>약 10분</span></div>
          <span class="eum_ar">3호선 원당역에서 화정역까지 단 한 정거장입니다.</span>
        </div>
        <div class="eum_area eum_rv eum_d3">
          <b>행신동</b>
          <span class="eum_ad">고양시 덕양구</span>
          <div class="eum_ats"><span class="eum_at"><em>지하철</em>약 15~20분</span><span class="eum_at"><em>자가용</em>약 10분</span></div>
          <span class="eum_ar">경의중앙선 행신역에서 대곡역 환승 후 3호선 화정역으로 오시거나, 화정역 방면 시내버스를 이용하면 환승 없이 오실 수 있습니다.</span>
        </div>
        <div class="eum_area eum_rv eum_d4">
          <b>능곡동 · 토당동</b>
          <span class="eum_ad">고양시 덕양구</span>
          <div class="eum_ats"><span class="eum_at"><em>지하철</em>약 15분</span><span class="eum_at"><em>자가용</em>약 10분</span></div>
          <span class="eum_ar">경의중앙선 능곡역에서 대곡역(한 정거장) 환승 후 3호선으로 화정역까지 옵니다.</span>
        </div>
        <div class="eum_area eum_rv eum_d4">
          <b>주교동 · 고양시청</b>
          <span class="eum_ad">고양시 덕양구</span>
          <div class="eum_ats"><span class="eum_at"><em>지하철</em>약 3분 <em>(1정거장)</em></span><span class="eum_at"><em>자가용</em>약 10분</span></div>
          <span class="eum_ar">고양시청 일대에서 원당역 이용 시 화정역까지 한 정거장입니다.</span>
        </div>
        <div class="eum_area eum_rv eum_d4">
          <b>삼송동 · 원흥동</b>
          <span class="eum_ad">고양시 덕양구</span>
          <div class="eum_ats"><span class="eum_at"><em>지하철</em>약 7분 <em>(3정거장)</em></span><span class="eum_at"><em>자가용</em>약 12분</span></div>
          <span class="eum_ar">3호선 삼송역에서 화정역까지 세 정거장입니다.</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════ 인근 도시 ═══════════ -->
  <section class="eum_sec eum_alt">
    <div class="eum_wrap">
      <div class="eum_shead eum_rv">
        <span class="eum_eyebrow"><span class="eum_bar"></span>NEARBY CITIES</span>
        <h2 class="eum_h2">파주 · 서울 은평에서 오시는 길</h2>
      </div>
      <div class="eum_areas">
        <div class="eum_area eum_rv">
          <b>파주 운정 · 교하</b>
          <span class="eum_ad">파주시</span>
          <div class="eum_ats"><span class="eum_at"><em>지하철</em>약 30분</span><span class="eum_at"><em>자가용</em>약 25분</span></div>
          <span class="eum_ar">경의중앙선으로 대곡역까지 온 뒤 3호선 화정역으로 한 정거장 이동합니다.</span>
        </div>
        <div class="eum_area eum_rv eum_d2">
          <b>서울 은평 · 구파발</b>
          <span class="eum_ad">서울특별시 은평구</span>
          <div class="eum_ats"><span class="eum_at"><em>지하철</em>약 9분 <em>(4정거장)</em></span><span class="eum_at"><em>자가용</em>약 15분</span></div>
          <span class="eum_ar">3호선 구파발역에서 화정역까지 네 정거장, 환승 없이 옵니다.</span>
        </div>
      </div>
      <div class="eum_notebox eum_rv" style="margin-top:32px">
        <p>소요시간은 지하철 승차역~화정역 기준이며, 집에서 역까지 가는 시간과 화정역에서 병원까지 도보 5분은 별도입니다. 실제 시간은 시간대와 교통 상황에 따라 달라질 수 있습니다.</p>
      </div>
    </div>
  </section>

