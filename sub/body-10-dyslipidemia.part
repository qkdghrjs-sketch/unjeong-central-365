<div id="eumSub">

  <!-- ═══════════ 서브 히어로 ═══════════ -->
  <section class="eum_hero eum_img">
    <div class="eum_wrap">
      <div>
        <span class="eum_eyebrow eum_rv"><span class="eum_bar"></span>CHRONIC DISEASE CLINIC · 만성질환클리닉</span>
        <h1 class="eum_h1 eum_rv eum_d1">고지혈증<br><em>Hyperlipidemia</em></h1>
        <p class="eum_hsub eum_rv eum_d2">콜레스테롤·중성지방 관리부터 동맥경화 예방까지,<br>이움내과 내과 전문의가 체계적으로 함께합니다.</p>
        <div class="eum_badges eum_rv eum_d3">
          <span class="eum_badge"><span class="eum_dot"></span>지질 검사</span>
          <span class="eum_badge"><span class="eum_dot"></span>콜레스테롤 관리</span>
          <span class="eum_badge"><span class="eum_dot"></span>동맥경화 예방</span>
          <span class="eum_badge"><span class="eum_dot"></span>맞춤 약물 치료</span>
        </div>
      </div>
      <div class="eum_himg eum_rv eum_d2">
        <img src="https://cdn.imweb.me/thumbnail/20260308/0262aa47b6a74.png" alt="고지혈증 진료" loading="lazy">
      </div>
    </div>
  </section>

  <!-- ═══════════ 고지혈증이란? ═══════════ -->
  <section class="eum_sec">
    <div class="eum_wrap">
      <div class="eum_intro eum_rv">
        <div class="eum_introimg">
          <img src="https://cdn.imweb.me/thumbnail/20260308/d469ad239055b.png" alt="고지혈증 소개" loading="lazy">
        </div>
        <div>
          <h2>고지혈증이란?</h2>
          <span class="eum_en">Hyperlipidemia / Dyslipidemia</span>
          <p>고지혈증(이상지질혈증)은 혈액 속 콜레스테롤이나 중성지방이 정상 범위를 초과하거나, 좋은 콜레스테롤(HDL)이 지나치게 낮은 상태를 말합니다.</p>
          <p>고혈압·당뇨병과 마찬가지로 뚜렷한 자각 증상이 없어 건강검진에서 우연히 발견되는 경우가 대부분입니다. 이 때문에 방치하기 쉽지만, 오랜 기간 지속될 경우 혈관 벽에 지방이 쌓여 동맥경화가 진행됩니다.</p>
          <p>동맥경화는 심근경색·협심증·뇌졸중 등 생명을 위협하는 심뇌혈관 질환의 핵심 원인으로, 조기 발견과 꾸준한 관리가 매우 중요합니다.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════ 위험 신호 ═══════════ -->
  <section class="eum_sec eum_alt">
    <div class="eum_wrap">
      <div class="eum_shead eum_rv">
        <span class="eum_eyebrow"><span class="eum_bar"></span>SYMPTOMS &amp; RISK</span>
        <h2 class="eum_h2">고지혈증 위험 신호</h2>
      </div>

      <div class="eum_cat eum_rv"><span class="eum_cline"></span><b>고지혈증 특징 (대부분 무증상)</b></div>
      <div class="eum_symps">
        <div class="eum_symp eum_rv"><i>01</i><b>무증상</b><span>대부분 증상이 없어 건강검진으로 발견</span></div>
        <div class="eum_symp eum_rv eum_d1"><i>02</i><b>피로·무기력</b><span>혈액순환 저하로 인한 만성 피로감</span></div>
        <div class="eum_symp eum_rv eum_d2"><i>03</i><b>황색종</b><span>눈꺼풀·힘줄에 콜레스테롤 침착 발생</span></div>
      </div>

      <div class="eum_cat eum_c2 eum_rv"><span class="eum_cline"></span><b>방치 시 위험한 합병증</b></div>
      <div class="eum_symps">
        <div class="eum_symp eum_rv"><i>01</i><b>동맥경화·협심증</b><span>혈관 벽에 지방 축적으로 협착</span></div>
        <div class="eum_symp eum_rv eum_d1"><i>02</i><b>심근경색</b><span>관상동맥 완전 막힘으로 심장 괴사</span></div>
        <div class="eum_symp eum_rv eum_d2"><i>03</i><b>뇌졸중</b><span>뇌혈관 막힘·파열로 뇌손상 유발</span></div>
      </div>
    </div>
  </section>

  <!-- ═══════════ 치료 방법 ═══════════ -->
  <section class="eum_sec">
    <div class="eum_wrap">
      <div class="eum_shead eum_rv">
        <span class="eum_eyebrow"><span class="eum_bar"></span>TREATMENT</span>
        <h2 class="eum_h2">이움내과 고지혈증 치료 방법</h2>
        <p class="eum_lead">식이요법·운동과 함께 필요 시 약물 치료를 병행해 콜레스테롤을 목표 수치로 관리합니다.</p>
      </div>
      <div class="eum_trts">
        <div class="eum_trt eum_rv">
          <span class="eum_tno">01</span>
          <h3>식이요법 및 생활습관 개선</h3>
          <div class="eum_ti"><span class="eum_pt"></span><span><strong>포화지방 제한:</strong> 삼겹살·버터·튀김 등 포화지방 음식을 줄이고 불포화지방(견과류·올리브오일) 선택</span></div>
          <div class="eum_ti"><span class="eum_pt"></span><span><strong>콜레스테롤 섭취 제한:</strong> 계란 노른자·내장류·새우 등 하루 300mg 이하로 제한</span></div>
          <div class="eum_ti"><span class="eum_pt"></span><span><strong>식이섬유 섭취 증가:</strong> 채소·과일·통곡물·콩류 충분히 섭취해 콜레스테롤 흡수 억제</span></div>
          <div class="eum_ti"><span class="eum_pt"></span><span><strong>금주·금연:</strong> 알코올은 중성지방을 높이고, 흡연은 HDL 콜레스테롤을 낮춤</span></div>
        </div>
        <div class="eum_trt eum_rv eum_d1">
          <span class="eum_tno">02</span>
          <h3>규칙적인 운동으로 지질 개선</h3>
          <div class="eum_ti"><span class="eum_pt"></span><span><strong>운동 효과:</strong> 유산소 운동은 HDL(좋은 콜레스테롤)을 높이고 중성지방을 낮춤</span></div>
          <div class="eum_ti"><span class="eum_pt"></span><span><strong>권장 운동:</strong> 빠른 걷기·자전거·수영 등 주 3~5회 30분 이상 시행</span></div>
          <div class="eum_ti"><span class="eum_pt"></span><span><strong>체중 관리:</strong> 체중 5~10% 감량만으로도 LDL 콜레스테롤이 유의미하게 감소</span></div>
          <div class="eum_ti"><span class="eum_pt"></span><span><strong>꾸준한 습관화:</strong> 단기 집중보다 매일 조금씩 실천하는 것이 효과적</span></div>
        </div>
        <div class="eum_trt eum_rv eum_d2">
          <span class="eum_tno">03</span>
          <h3>전문의 진단에 따른 약물 치료</h3>
          <div class="eum_ti"><span class="eum_pt"></span><span><strong>스타틴 계열:</strong> LDL 콜레스테롤을 낮추는 가장 효과적인 1차 약물</span></div>
          <div class="eum_ti"><span class="eum_pt"></span><span><strong>피브레이트 계열:</strong> 중성지방이 높은 경우 주로 처방되는 약물</span></div>
          <div class="eum_ti"><span class="eum_pt"></span><span><strong>맞춤 처방:</strong> 동반 질환(당뇨·고혈압·신장질환)과 목표 수치에 따라 약물 조합 결정</span></div>
          <div class="eum_ti"><span class="eum_pt"></span><span><strong>지속 복용:</strong> 콜레스테롤 약은 임의 중단 시 수치 반등으로 심혈관 위험 상승</span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════ 핵심 요약 ═══════════ -->
  <section class="eum_sec eum_alt">
    <div class="eum_wrap">
      <div class="eum_sum eum_rv">
        <div class="eum_sumt">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M8.5 12.5l2.5 2.5 4.5-5"/></svg>
          고지혈증 치료 핵심 요약
        </div>
        <div class="eum_sumi"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M8.5 12.5l2.5 2.5 4.5-5"/></svg><span><strong>정기적인 지질 검사 :</strong> 콜레스테롤은 증상이 없으므로 최소 1년에 1회 혈액검사로 수치를 확인합니다.</span></div>
        <div class="eum_sumi"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M8.5 12.5l2.5 2.5 4.5-5"/></svg><span><strong>저지방 식단·운동 병행 :</strong> 포화지방 섭취를 줄이고 유산소 운동으로 HDL을 높여 LDL과 중성지방을 낮춥니다.</span></div>
        <div class="eum_sumi"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M8.5 12.5l2.5 2.5 4.5-5"/></svg><span><strong>약물 꾸준히 복용 :</strong> 스타틴 등 처방약은 임의로 끊지 않고 전문의 지시에 따라 지속적으로 복용합니다.</span></div>
      </div>
    </div>
  </section>

