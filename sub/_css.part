<style>
@import url('https://cdn.jsdelivr.net/gh/sun-typeface/suit@2/fonts/variable/woff2/SUIT-Variable.css');

/* ══════════════════════════════════════════════════════════════
   이움내과 세부페이지 공통 스타일  (모든 세부페이지가 동일)
   ─ 모든 스타일은 #eumSub 안에서만 적용됩니다.
   ══════════════════════════════════════════════════════════════ */
#eumSub{
  --eum-teal:#0C2D37; --eum-teal2:#12414F;
  --eum-mint:#36B8A5; --eum-mint-d:#2A9B8B; --eum-mint-l:#E9F7F4;
  --eum-body:#3F565F; --eum-gray:#7A8E96;
  --eum-line:#E4EBED; --eum-line2:#F0F4F5; --eum-paper2:#F6F9F9;
  --eum-ease:cubic-bezier(.16,1,.3,1);
  line-height:1.85 !important;
  --eum-maxw:1400px; --eum-pad:32px; --eum-r:6px;

  display:block !important; position:relative !important;
  float:none !important; clear:both !important;
  width:100% !important; max-width:100% !important;
  margin:0 !important; padding:0 !important;
  background:#fff !important; overflow:visible !important;
  box-sizing:border-box !important; z-index:auto !important;
}
#eumSub,#eumSub *,#eumSub *::before,#eumSub *::after{
  box-sizing:border-box !important;
  font-family:'SUIT Variable','SUIT',-apple-system,BlinkMacSystemFont,'Pretendard','Apple SD Gothic Neo',sans-serif !important;
  word-break:keep-all !important;
}
#eumSub ul,#eumSub ol,#eumSub li{list-style:none !important;margin:0 !important;padding:0 !important;background-image:none !important;}
#eumSub li::before,#eumSub li::after{display:none !important;content:none !important;}
#eumSub p,#eumSub h1,#eumSub h2,#eumSub h3,#eumSub h4,#eumSub span,#eumSub a,#eumSub div,#eumSub em,#eumSub strong,#eumSub b{margin:0 !important;padding:0 !important;}
#eumSub a{text-decoration:none !important;color:inherit !important;}
#eumSub img{max-width:100% !important;display:block !important;}
#eumSub svg{display:inline-block !important;}
#eumSub button{font:inherit !important;color:inherit !important;background:none !important;border:0 !important;margin:0 !important;padding:0 !important;cursor:pointer !important;text-align:left !important;}
#eumSub table{border-collapse:collapse !important;width:100% !important;margin:0 !important;}

#eumSub .eum_wrap{max-width:var(--eum-maxw) !important;margin:0 auto !important;padding:0 var(--eum-pad) !important;width:100% !important;}
#eumSub .eum_narrow{max-width:1000px !important;margin:0 auto !important;padding:0 var(--eum-pad) !important;width:100% !important;}

#eumSub .eum_rv{opacity:0 !important;transform:translateY(26px) !important;transition:opacity .9s var(--eum-ease),transform .9s var(--eum-ease) !important;}
#eumSub .eum_rv.eum_in{opacity:1 !important;transform:none !important;}
#eumSub .eum_d1{transition-delay:.08s !important;}
#eumSub .eum_d2{transition-delay:.16s !important;}
#eumSub .eum_d3{transition-delay:.24s !important;}
#eumSub .eum_d4{transition-delay:.32s !important;}

/* ── 서브 히어로 ── */
#eumSub .eum_hero{
  position:relative !important;background:var(--eum-teal) !important;color:#fff !important;
  padding:170px 0 100px !important;overflow:hidden !important;
}
#eumSub .eum_hero::before{
  content:'' !important;position:absolute !important;right:-180px !important;top:-200px !important;
  width:680px !important;height:680px !important;border-radius:50% !important;
  background:radial-gradient(circle,rgba(54,184,165,.20),rgba(54,184,165,0) 68%) !important;pointer-events:none !important;
}
#eumSub .eum_hero .eum_wrap{position:relative !important;}
#eumSub .eum_eyebrow{
  display:flex !important;align-items:center !important;gap:12px !important;
  font-size:12px !important;font-weight:700 !important;letter-spacing:.18em !important;color:var(--eum-mint) !important;
}
#eumSub .eum_eyebrow .eum_bar{display:block !important;width:26px !important;height:1px !important;background:var(--eum-mint) !important;flex:none !important;}
#eumSub .eum_h1{
  display:block !important;margin:24px 0 22px !important;
  font-size:clamp(30px,4.4vw,52px) !important;font-weight:800 !important;
  line-height:1.34 !important;letter-spacing:-.05em !important;color:#fff !important;
}
#eumSub .eum_h1 em{font-style:normal !important;color:var(--eum-mint) !important;}
#eumSub .eum_hsub{
  display:block !important;max-width:860px !important;
  font-size:clamp(15px,1.6vw,17.5px) !important;line-height:1.92 !important;
  color:rgba(255,255,255,.74) !important;font-weight:400 !important;
}
#eumSub .eum_badges{display:flex !important;flex-wrap:wrap !important;gap:8px !important;margin-top:30px !important;}
#eumSub .eum_badge{
  display:inline-flex !important;align-items:center !important;gap:8px !important;
  height:36px !important;padding:0 16px !important;border-radius:999px !important;
  background:rgba(255,255,255,.07) !important;border:1px solid rgba(255,255,255,.18) !important;
  font-size:12.5px !important;font-weight:700 !important;color:#fff !important;letter-spacing:-.035em !important;
}
#eumSub .eum_badge .eum_dot{display:block !important;width:5px !important;height:5px !important;border-radius:50% !important;background:var(--eum-mint) !important;flex:none !important;}

/* ── 섹션 ── */
#eumSub .eum_sec{padding:110px 0 !important;background:#fff !important;}
#eumSub .eum_sec.eum_alt{background:var(--eum-paper2) !important;border-top:1px solid var(--eum-line) !important;border-bottom:1px solid var(--eum-line) !important;}
#eumSub .eum_shead{margin-bottom:44px !important;}
#eumSub .eum_shead .eum_eyebrow{color:var(--eum-mint) !important;}
#eumSub .eum_h2{
  display:block !important;margin:20px 0 0 !important;
  font-size:clamp(26px,3.4vw,40px) !important;font-weight:800 !important;
  line-height:1.4 !important;letter-spacing:-.045em !important;color:var(--eum-teal) !important;
}
#eumSub .eum_lead{display:block !important;margin-top:16px !important;font-size:clamp(15px,1.6vw,17px) !important;line-height:1.92 !important;color:var(--eum-body) !important;}

/* ── 핵심 답변 ── */
#eumSub .eum_key{
  border-left:3px solid var(--eum-mint) !important;
  padding:6px 0 6px 30px !important;
}
#eumSub .eum_key .eum_q{
  display:block !important;font-size:13px !important;font-weight:700 !important;
  letter-spacing:.02em !important;color:var(--eum-mint-d) !important;margin-bottom:16px !important;
}
#eumSub .eum_key p{
  display:block !important;font-size:clamp(16px,1.8vw,19px) !important;line-height:1.95 !important;
  color:var(--eum-body) !important;letter-spacing:-.035em !important;
}
#eumSub .eum_key p + p{margin-top:14px !important;}
#eumSub .eum_key strong{font-weight:800 !important;color:var(--eum-teal) !important;}
#eumSub .eum_facts{display:grid !important;grid-template-columns:repeat(auto-fit,minmax(210px,1fr)) !important;gap:10px !important;margin-top:30px !important;}
#eumSub .eum_fact{
  display:flex !important;align-items:center !important;gap:9px !important;
  padding:15px 17px !important;border-radius:var(--eum-r) !important;
  background:var(--eum-mint-l) !important;
  font-size:13.5px !important;font-weight:700 !important;color:var(--eum-teal) !important;letter-spacing:-.035em !important;line-height:1.5 !important;
}
#eumSub .eum_fact svg{width:15px !important;height:15px !important;color:var(--eum-mint-d) !important;flex:none !important;}

/* ── 배너 카드 ── */
#eumSub .eum_banner{
  background:var(--eum-teal) !important;color:#fff !important;border-radius:var(--eum-r) !important;
  padding:52px 48px !important;position:relative !important;overflow:hidden !important;
}
#eumSub .eum_banner::before{
  content:'' !important;position:absolute !important;right:-140px !important;top:-160px !important;
  width:520px !important;height:520px !important;border-radius:50% !important;
  background:radial-gradient(circle,rgba(54,184,165,.18),rgba(54,184,165,0) 68%) !important;pointer-events:none !important;
}
#eumSub .eum_banner .eum_in2{position:relative !important;}
#eumSub .eum_bbadge{
  display:inline-flex !important;align-items:center !important;height:30px !important;padding:0 14px !important;
  border-radius:999px !important;background:rgba(54,184,165,.16) !important;border:1px solid rgba(54,184,165,.34) !important;
  font-size:11px !important;font-weight:700 !important;letter-spacing:.14em !important;color:var(--eum-mint) !important;
}
#eumSub .eum_btitle{display:block !important;margin:20px 0 12px !important;font-size:clamp(24px,3vw,34px) !important;font-weight:800 !important;letter-spacing:-.05em !important;line-height:1.4 !important;color:#fff !important;}
#eumSub .eum_bsub{display:block !important;font-size:16px !important;color:var(--eum-mint) !important;font-weight:700 !important;letter-spacing:-.035em !important;}
#eumSub .eum_bitems{display:grid !important;grid-template-columns:repeat(auto-fit,minmax(230px,1fr)) !important;gap:10px !important;margin-top:32px !important;}
#eumSub .eum_bitem{
  display:flex !important;align-items:center !important;gap:10px !important;
  padding:16px 18px !important;border-radius:var(--eum-r) !important;
  background:rgba(255,255,255,.06) !important;border:1px solid rgba(255,255,255,.13) !important;
  font-size:14px !important;font-weight:600 !important;color:#fff !important;letter-spacing:-.035em !important;line-height:1.5 !important;
}
#eumSub .eum_bitem svg{width:15px !important;height:15px !important;color:var(--eum-mint) !important;flex:none !important;}
#eumSub .eum_blogos{display:flex !important;flex-wrap:wrap !important;gap:8px !important;margin-top:26px !important;padding-top:26px !important;border-top:1px solid rgba(255,255,255,.13) !important;}
#eumSub .eum_blogo{
  display:inline-flex !important;align-items:center !important;gap:7px !important;height:34px !important;padding:0 14px !important;
  border-radius:999px !important;background:rgba(255,255,255,.07) !important;
  font-size:12.5px !important;font-weight:700 !important;color:rgba(255,255,255,.86) !important;letter-spacing:-.035em !important;
}
#eumSub .eum_blogo svg{width:13px !important;height:13px !important;color:var(--eum-mint) !important;flex:none !important;}

/* ── 표 ── */
#eumSub .eum_tablewrap{overflow-x:auto !important;-webkit-overflow-scrolling:touch !important;border-radius:var(--eum-r) !important;border:1px solid var(--eum-line) !important;background:#fff !important;}
#eumSub .eum_table{min-width:680px !important;}
#eumSub .eum_table th{
  background:var(--eum-teal) !important;color:#fff !important;
  padding:17px 20px !important;font-size:13.5px !important;font-weight:700 !important;
  letter-spacing:-.03em !important;text-align:left !important;white-space:nowrap !important;
}
#eumSub .eum_table td{
  padding:20px !important;border-bottom:1px solid var(--eum-line2) !important;
  font-size:14.5px !important;color:var(--eum-body) !important;line-height:1.85 !important;letter-spacing:-.035em !important;vertical-align:top !important;
}
#eumSub .eum_table tr:last-child td{border-bottom:0 !important;}
#eumSub .eum_table td.eum_head{background:var(--eum-paper2) !important;white-space:nowrap !important;}
#eumSub .eum_table td .eum_no{display:block !important;font-size:17px !important;font-weight:800 !important;color:var(--eum-mint-d) !important;margin-bottom:6px !important;letter-spacing:.02em !important;}
#eumSub .eum_table td .eum_area{display:block !important;font-size:14.5px !important;font-weight:700 !important;color:var(--eum-teal) !important;}
#eumSub .eum_table td.eum_mid{font-weight:700 !important;color:var(--eum-teal) !important;white-space:nowrap !important;}
#eumSub .eum_tnote{display:block !important;margin-top:16px !important;font-size:13px !important;color:var(--eum-gray) !important;letter-spacing:-.03em !important;}

/* ── 체크 목록 ── */
#eumSub .eum_checks{display:grid !important;grid-template-columns:repeat(auto-fit,minmax(320px,1fr)) !important;gap:14px !important;}
#eumSub .eum_check{
  display:flex !important;align-items:flex-start !important;gap:14px !important;
  padding:24px 24px !important;border-radius:var(--eum-r) !important;
  background:#fff !important;border:1px solid var(--eum-line) !important;
  font-size:14.5px !important;color:var(--eum-body) !important;line-height:1.85 !important;letter-spacing:-.035em !important;
}
#eumSub .eum_check .eum_ck{
  display:flex !important;width:26px !important;height:26px !important;border-radius:50% !important;flex:none !important;
  background:var(--eum-mint-l) !important;align-items:center !important;justify-content:center !important;margin-top:2px !important;
}
#eumSub .eum_check .eum_ck svg{width:14px !important;height:14px !important;color:var(--eum-mint-d) !important;}

/* ── FAQ ── */
#eumSub .eum_tabs{display:flex !important;flex-wrap:wrap !important;gap:8px !important;margin-bottom:28px !important;}
#eumSub .eum_tab{
  display:inline-flex !important;align-items:center !important;height:42px !important;padding:0 20px !important;
  border-radius:999px !important;border:1px solid var(--eum-line) !important;background:#fff !important;
  font-size:13.5px !important;font-weight:700 !important;color:var(--eum-body) !important;letter-spacing:-.035em !important;
  transition:background .25s var(--eum-ease),border-color .25s var(--eum-ease),color .25s var(--eum-ease) !important;
}
#eumSub .eum_tab:hover{border-color:var(--eum-mint) !important;color:var(--eum-mint-d) !important;}
#eumSub .eum_tab.eum_on{background:var(--eum-teal) !important;border-color:var(--eum-teal) !important;color:#fff !important;}
#eumSub .eum_tab i{font-style:normal !important;margin-left:7px !important;font-size:11.5px !important;opacity:.6 !important;}

#eumSub .eum_group{display:none !important;}
#eumSub .eum_group.eum_on{display:block !important;}
#eumSub .eum_qa{border-top:1.5px solid var(--eum-teal) !important;}
#eumSub .eum_item{border-bottom:1px solid var(--eum-line) !important;}
#eumSub .eum_qbtn{
  display:flex !important;width:100% !important;align-items:flex-start !important;gap:16px !important;
  padding:24px 6px !important;
}
#eumSub .eum_qbtn .eum_qm{
  font-size:14px !important;font-weight:800 !important;color:var(--eum-mint) !important;flex:none !important;
  line-height:1.7 !important;
}
#eumSub .eum_qbtn .eum_qt{
  flex:1 !important;font-size:16.5px !important;font-weight:700 !important;color:var(--eum-teal) !important;
  letter-spacing:-.04em !important;line-height:1.7 !important;
  transition:color .25s var(--eum-ease) !important;
}
#eumSub .eum_qbtn:hover .eum_qt{color:var(--eum-mint-d) !important;}
#eumSub .eum_qbtn .eum_sign{
  position:relative !important;width:20px !important;height:20px !important;flex:none !important;margin-top:6px !important;
}
#eumSub .eum_qbtn .eum_sign::before,#eumSub .eum_qbtn .eum_sign::after{
  content:'' !important;position:absolute !important;left:50% !important;top:50% !important;
  background:var(--eum-mint) !important;border-radius:2px !important;
  transition:transform .35s var(--eum-ease) !important;
}
#eumSub .eum_qbtn .eum_sign::before{width:14px !important;height:2px !important;transform:translate(-50%,-50%) !important;}
#eumSub .eum_qbtn .eum_sign::after{width:2px !important;height:14px !important;transform:translate(-50%,-50%) !important;}
#eumSub .eum_item.eum_open .eum_sign::after{transform:translate(-50%,-50%) scaleY(0) !important;}
#eumSub .eum_abox{max-height:0 !important;overflow:hidden !important;transition:max-height .45s var(--eum-ease) !important;}
#eumSub .eum_ain{padding:0 6px 28px 46px !important;}
#eumSub .eum_ain p{
  display:block !important;font-size:15px !important;line-height:1.95 !important;
  color:var(--eum-body) !important;letter-spacing:-.035em !important;
}
#eumSub .eum_ain p + p{margin-top:12px !important;}

/* ── CTA ── */
#eumSub .eum_cta{background:var(--eum-teal) !important;color:#fff !important;padding:100px 0 !important;position:relative !important;overflow:hidden !important;}
#eumSub .eum_cta::before{
  content:'' !important;position:absolute !important;left:50% !important;top:-260px !important;transform:translateX(-50%) !important;
  width:820px !important;height:560px !important;border-radius:50% !important;
  background:radial-gradient(circle,rgba(54,184,165,.16),rgba(54,184,165,0) 68%) !important;pointer-events:none !important;
}
#eumSub .eum_cta .eum_wrap{position:relative !important;text-align:center !important;}
#eumSub .eum_ctitle{display:block !important;font-size:clamp(26px,3.4vw,40px) !important;font-weight:800 !important;letter-spacing:-.05em !important;line-height:1.42 !important;color:#fff !important;}
#eumSub .eum_csub{display:block !important;margin-top:20px !important;font-size:clamp(15px,1.6vw,17px) !important;line-height:1.92 !important;color:rgba(255,255,255,.72) !important;}
#eumSub .eum_cbtns{display:flex !important;flex-wrap:wrap !important;justify-content:center !important;gap:10px !important;margin-top:38px !important;}
#eumSub .eum_cbtn{
  display:inline-flex !important;align-items:center !important;justify-content:center !important;gap:9px !important;
  height:56px !important;padding:0 32px !important;border-radius:999px !important;
  font-size:15px !important;font-weight:700 !important;letter-spacing:-.035em !important;
  transition:background .3s var(--eum-ease),border-color .3s var(--eum-ease),transform .3s var(--eum-ease) !important;
}
#eumSub .eum_cbtn.eum_p{background:var(--eum-mint) !important;color:#fff !important;box-shadow:0 12px 30px -12px rgba(54,184,165,.9) !important;}
#eumSub .eum_cbtn.eum_p:hover{background:var(--eum-mint-d) !important;transform:translateY(-2px) !important;}
#eumSub .eum_cbtn.eum_g{border:1px solid rgba(255,255,255,.32) !important;color:#fff !important;}
#eumSub .eum_cbtn.eum_g:hover{background:rgba(255,255,255,.12) !important;border-color:rgba(255,255,255,.6) !important;transform:translateY(-2px) !important;}
#eumSub .eum_cbtn svg{width:15px !important;height:15px !important;flex:none !important;}


/* ── 인용 박스 (병원 철학) ── */
#eumSub .eum_quote{
  background:#fff !important;border:1px solid var(--eum-line) !important;border-radius:var(--eum-r) !important;
  padding:60px 48px !important;text-align:center !important;
}
#eumSub .eum_qtext{
  display:block !important;font-size:clamp(20px,2.6vw,30px) !important;font-weight:800 !important;
  color:var(--eum-teal) !important;line-height:1.62 !important;letter-spacing:-.045em !important;
}
#eumSub .eum_qtext strong{color:var(--eum-mint-d) !important;font-weight:800 !important;}
#eumSub .eum_qsub{
  display:block !important;margin-top:26px !important;font-size:15.5px !important;
  color:var(--eum-body) !important;line-height:1.92 !important;letter-spacing:-.035em !important;
}

/* ── 특징 목록 (번호 + 제목 + 설명) ── */
#eumSub .eum_feats{border-top:1px solid var(--eum-line) !important;}
#eumSub .eum_feat{
  display:grid !important;grid-template-columns:112px minmax(0,1fr) !important;gap:34px !important;
  padding:38px 0 !important;border-bottom:1px solid var(--eum-line) !important;
}
#eumSub .eum_feat .eum_fno{
  display:block !important;font-size:48px !important;font-weight:900 !important;line-height:1 !important;
  color:#F0F7F6 !important;-webkit-text-stroke:1.5px var(--eum-mint) !important;letter-spacing:-.02em !important;
}
#eumSub .eum_feat h3{
  display:block !important;font-size:21px !important;font-weight:800 !important;color:var(--eum-teal) !important;
  letter-spacing:-.045em !important;line-height:1.55 !important;margin-bottom:14px !important;
}
#eumSub .eum_feat p{
  display:block !important;font-size:15.5px !important;color:var(--eum-body) !important;
  line-height:1.92 !important;letter-spacing:-.035em !important;
}

/* ── 답변 안의 목록 · 표 · 강조 박스 ── */
#eumSub .eum_ain ul,#eumSub .eum_ain ol{margin:12px 0 !important;padding-left:20px !important;}
#eumSub .eum_ain li{
  list-style:disc !important;margin:0 0 7px !important;padding:0 !important;
  font-size:15px !important;line-height:1.9 !important;color:var(--eum-body) !important;letter-spacing:-.035em !important;
}
#eumSub .eum_ain ol li{list-style:decimal !important;}
#eumSub .eum_ain li::before,#eumSub .eum_ain li::after{display:none !important;content:none !important;}
#eumSub .eum_ain strong{font-weight:800 !important;color:var(--eum-teal) !important;}
#eumSub .eum_atable{overflow-x:auto !important;-webkit-overflow-scrolling:touch !important;margin:16px 0 !important;border:1px solid var(--eum-line) !important;border-radius:var(--eum-r) !important;}
#eumSub .eum_ain table{min-width:420px !important;}
#eumSub .eum_ain th{
  background:var(--eum-paper2) !important;padding:13px 15px !important;
  font-size:13px !important;font-weight:700 !important;color:var(--eum-teal) !important;
