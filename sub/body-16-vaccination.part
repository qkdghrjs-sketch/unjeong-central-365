<div id="eumSub">

  <!-- ═══════════ 서브 히어로 ═══════════ -->
  <section class="eum_hero">
    <div class="eum_wrap">
      <span class="eum_eyebrow eum_rv"><span class="eum_bar"></span>VACCINATION · 예방접종</span>
      <h1 class="eum_h1 eum_rv eum_d1">예방접종,<br><em>어른에게도 필요합니다</em></h1>
      <p class="eum_hsub eum_rv eum_d2">나이가 들수록 면역력은 떨어지고, 폐렴·대상포진·간염처럼 성인에게 더 위험한 감염병이 있습니다.<br>이움내과의원은 국가예방접종부터 성인 권장 예방접종까지, 진료 상담을 통해 꼭 필요한 접종을 안내해 드립니다.</p>
      <div class="eum_badges eum_rv eum_d3">
        <span class="eum_badge"><span class="eum_dot"></span>국가예방접종 지정기관</span>
        <span class="eum_badge"><span class="eum_dot"></span>폐렴구균 캡박시브(21가)</span>
        <span class="eum_badge"><span class="eum_dot"></span>대상포진 2종 보유</span>
        <span class="eum_badge"><span class="eum_dot"></span>가다실 9가</span>
      </div>
    </div>
  </section>

  <!-- ═══════════ 배너 ═══════════ -->
  <section class="eum_sec">
    <div class="eum_wrap">
      <div class="eum_banner eum_rv">
        <div class="eum_in2">
          <span class="eum_bbadge">NATIONAL VACCINATION AGENCY</span>
          <span class="eum_btitle">국가예방접종 위탁의료기관</span>
          <span class="eum_bsub">보건소 방문 없이, 가까운 본원에서 국가예방접종을 무료로(대상자 기준)</span>
          <div class="eum_bitems">
            <span class="eum_bitem"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>인플루엔자 · 폐렴구균 · HPV · 코로나19</span>
            <span class="eum_bitem"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>진료 상담 통한 맞춤 접종 안내</span>
            <span class="eum_bitem"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>성인 권장 예방접종도 한 곳에서</span>
          </div>
          <div class="eum_blogos">
            <span class="eum_blogo"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>국가예방접종 위탁의료기관</span>
            <span class="eum_blogo"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>방문 전 예약 권장 ☎ 031-979-0875</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════ 국가예방접종 ═══════════ -->
  <section class="eum_sec eum_alt">
    <div class="eum_wrap">
      <div class="eum_shead eum_rv">
        <span class="eum_eyebrow"><span class="eum_bar"></span>NATIONAL IMMUNIZATION PROGRAM</span>
        <h2 class="eum_h2">국가예방접종(NIP) — 대상자는 무료</h2>
      </div>
      <div class="eum_tablewrap eum_rv eum_d1">
        <table class="eum_table">
          <thead>
            <tr>
              <th style="width:18%">종류</th>
              <th style="width:30%">무료 대상</th>
              <th style="width:22%">시기 · 횟수</th>
              <th style="width:30%">핵심 안내</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td class="eum_mid">① 인플루엔자(독감)</td>
              <td class="eum_hi">만 65세 이상, 생후 6개월~만 13세, 임신부</td>
              <td>매년 가을(9~10월)부터 이듬해 봄까지</td>
              <td>매년 유행 바이러스 변화, 합병증(폐렴 등) 예방</td>
            </tr>
            <tr>
              <td class="eum_mid">② 폐렴구균(어르신)</td>
              <td class="eum_hi">만 65세 이상 중 미접종자</td>
              <td>23가 다당질백신(PPSV23) 1회, 연중</td>
              <td>국내 사망 원인 상위권, 고령자 특히 위험</td>
            </tr>
            <tr>
              <td class="eum_mid">③ HPV(가다실)</td>
              <td class="eum_hi">여성 청소년 12~17세, 저소득층 여성 18~26세, 남성 청소년 12세(2026년~)</td>
              <td>14세 이전 2회 / 15세 이후 3회</td>
              <td>국가지원은 4가, 9가(가다실9)는 자비 접종</td>
            </tr>
            <tr>
              <td class="eum_mid">④ 코로나19</td>
              <td class="eum_hi">만 65세 이상, 생후 6개월 이상 면역저하자, 감염취약시설 입원·입소자</td>
              <td>매년 1회</td>
              <td>고위험군 외 일반 성인은 유료 접종 가능</td>
            </tr>
          </tbody>
        </table>
      </div>
      <span class="eum_tnote eum_rv eum_d2">※ 대상·기간은 매년 변경되며, 정확한 대상 여부는 예방접종도우미(nip.kdca.go.kr) 또는 진료 상담으로 확인하세요.</span>
    </div>
  </section>

  <!-- ═══════════ 성인 예방접종 ═══════════ -->
  <section class="eum_sec">
    <div class="eum_wrap">
      <div class="eum_shead eum_rv">
        <span class="eum_eyebrow"><span class="eum_bar"></span>ADULT VACCINATION GUIDE</span>
        <h2 class="eum_h2">일반(성인) 예방접종 — 자비 접종</h2>
      </div>
      <div class="eum_tablewrap eum_rv eum_d1">
        <table class="eum_table">
          <thead>
            <tr>
              <th style="width:20%">구분</th>
              <th style="width:25%">대상 · 횟수</th>
              <th style="width:55%">상세 안내</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td class="eum_mid">01. A형간염</td>
              <td>항체 없는 20~40대, 위험군 / 2회(0, 6~12개월)</td>
              <td>오염된 음식·물로 감염되며, 성인이 걸리면 더 심하게 앓을 수 있습니다. 국내 30~40대는 항체 보유율이 낮아 접종 전 항체검사를 권장합니다.</td>
            </tr>
            <tr>
              <td class="eum_mid">02. B형간염</td>
              <td>항체 없는 성인, 의료인 등 / 3회(0, 1, 6개월)</td>
              <td>혈액·체액으로 전파되며 만성화 시 간경변·간암으로 이어질 수 있습니다. 접종 전 항체검사를 권장합니다.</td>
            </tr>
            <tr>
              <td class="eum_mid">03. 폐렴구균 — 캡박시브(21가)</td>
              <td class="eum_hi">만 18세 이상 성인 / 1회 접종으로 완결</td>
              <td>성인 침습성 폐렴구균 질환(IPD)의 주요 21개 혈청형을 포함해 현재 국내 백신 중 가장 넓은 예방 범위를 제공합니다(2026년 3월 국내 출시). 2026년 5월 개정된 대한감염학회 권고안에 따라 순차접종 없이 1회로 예방을 완결할 수 있습니다. 기존 PCV13·15, PPSV23 접종 이력이 있어도 추가 접종이 가능합니다.</td>
            </tr>
            <tr>
              <td class="eum_mid">04. 대상포진</td>
              <td>만 50세 이상 / 면역저하 고위험군은 만 18세 이상</td>
              <td>수두 바이러스가 신경에 잠복해 있다가 면역력 저하 시 재활성화됩니다. 극심한 통증과 대상포진 후 신경통이 부담이 되며, 50세 이후 위험이 급증합니다. 싱그릭스(재조합, 2회)와 스카이조스터(생백신, 1회) 모두 보유하고 있어 상담 후 선택 접종이 가능합니다.</td>
            </tr>
            <tr>
              <td class="eum_mid">05. 가다실 9가(HPV)</td>
              <td class="eum_hi">만 9세 이상 남녀 / 15세 미만 2회, 15세 이상 3회</td>
              <td>HPV는 남녀 모두 감염되는 바이러스로, 여성의 자궁경부암뿐 아니라 남성의 항문암·음경암·구인두암·생식기사마귀도 일으킬 수 있습니다. WHO·미국 CDC도 남성 접종을 표준으로 권고합니다. 9가는 국가지원 대상이 아니어서 자비 접종입니다.</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- ═══════════ 대상포진 백신 비교 ═══════════ -->
  <section class="eum_sec eum_alt">
    <div class="eum_wrap">
      <div class="eum_shead eum_rv">
        <span class="eum_eyebrow"><span class="eum_bar"></span>SHINGLES VACCINE</span>
        <h2 class="eum_h2">대상포진 백신 비교</h2>
      </div>
      <div class="eum_tablewrap eum_rv eum_d1">
        <table class="eum_table">
          <thead>
            <tr>
              <th style="width:34%">구분</th>
              <th style="width:33%">싱그릭스 (재조합)</th>
              <th style="width:33%">스카이조스터 (생백신, 국산)</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td class="eum_mid">접종</td>
              <td class="eum_hi">2회 (2~6개월 간격), 근육주사</td>
              <td>1회, 피하주사</td>
            </tr>
            <tr>
              <td class="eum_mid">예방효과</td>
              <td class="eum_hi">90% 이상, 장기간 지속</td>
              <td>상대적으로 낮음</td>
            </tr>
            <tr>
              <td class="eum_mid">면역저하자</td>
              <td class="eum_hi">접종 가능</td>
              <td>생백신이라 부적합</td>
            </tr>
          </tbody>
        </table>
      </div>
      <span class="eum_tnote eum_rv eum_d2">※ 대한감염학회는 50세 이상에서 싱그릭스(재조합백신)를 우선 권고합니다. 접종 부위 통증·발열·피로 등 반응이 있을 수 있습니다.</span>
    </div>
  </section>

  <!-- ═══════════ 접종 전 안내 ═══════════ -->
  <section class="eum_sec">
    <div class="eum_wrap">
      <div class="eum_shead eum_rv">
        <span class="eum_eyebrow"><span class="eum_bar"></span>BEFORE YOU VISIT</span>
        <h2 class="eum_h2">예방접종 전 확인 및 안내사항</h2>
      </div>
      <div class="eum_checks eum_rv eum_d1">
        <div class="eum_check"><span class="eum_ck"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg></span>접종 전 현재 건강 상태, 복용 중인 약, 알레르기 여부를 진료 시 반드시 확인해 주세요.</div>
        <div class="eum_check"><span class="eum_ck"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg></span>국가예방접종 대상·지원 범위는 매년 변경될 수 있으니, 본인 대상 여부는 예방접종도우미(nip.kdca.go.kr) 또는 진료 상담으로 확인하시기 바랍니다.</div>
        <div class="eum_check"><span class="eum_ck"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg></span>A형·B형간염은 접종 전 항체검사를 통해 필요 여부를 확인한 후 접종하는 것을 권장합니다.</div>
        <div class="eum_check"><span class="eum_ck"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg></span>대상포진 백신은 싱그릭스·스카이조스터 두 가지를 모두 보유하고 있으며, 상담 후 원하시는 백신으로 접종하실 수 있습니다.</div>
        <div class="eum_check"><span class="eum_ck"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg></span>HPV(가다실)는 성생활 시작 전 접종이 가장 효과적이나, 이후에도 예방 효과를 기대할 수 있습니다.</div>
        <div class="eum_check"><span class="eum_ck"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg></span>원활한 접종을 위해 방문 전 전화 예약을 권해드립니다.</div>
      </div>
    </div>
  </section>

  <!-- ═══════════ 자주 묻는 질문 ═══════════ -->
  <section class="eum_sec eum_alt">
    <div class="eum_narrow">
      <div class="eum_shead eum_rv">
        <span class="eum_eyebrow"><span class="eum_bar"></span>FAQ</span>
        <h2 class="eum_h2">예방접종 자주 묻는 질문</h2>
      </div>

      <div class="eum_tabs eum_rv eum_d1">
        <button class="eum_tab eum_on" type="button">국가예방접종 기본 안내<i>4</i></button>
        <button class="eum_tab" type="button">폐렴구균 · 캡박시브 상세 안내<i>3</i></button>
        <button class="eum_tab" type="button">대상포진 · HPV<i>4</i></button>
        <button class="eum_tab" type="button">간염 등 성인 접종<i>2</i></button>
        <button class="eum_tab" type="button">동반질환자 접종 안내<i>3</i></button>
        <button class="eum_tab" type="button">접종 전후 안내<i>2</i></button>
      </div>

      <!-- 분류 1 : 국가예방접종 기본 안내 -->
      <div class="eum_group eum_on eum_rv eum_d2">
        <div class="eum_qa">
          <div class="eum_item">
            <button class="eum_qbtn" type="button" aria-expanded="false"><span class="eum_qm">Q</span><span class="eum_qt">이움내과에서는 어떤 예방접종을 하나요?</span><span class="eum_sign"></span></button>
            <div class="eum_abox"><div class="eum_ain"><p>이움내과의원은 인플루엔자(독감), 폐렴구균, 코로나19, 대상포진, A형간염, B형간염, 사람유두종바이러스(HPV, 가다실 9가) 예방접종을 시행하는 국가예방접종 지원사업 지정 의료기관입니다. 성인 폐렴구균 백신은 21가 단백접합백신(PCV21, 캡박시브)을 포함해 준비되어 있습니다. 접종 문의는 031-979-0875입니다.</p></div></div>
          </div>
          <div class="eum_item">
            <button class="eum_qbtn" type="button" aria-expanded="false"><span class="eum_qm">Q</span><span class="eum_qt">국가예방접종은 보건소에 가지 않아도 무료로 맞을 수 있나요?</span><span class="eum_sign"></span></button>
            <div class="eum_abox"><div class="eum_ain"><p>네. 이움내과의원은 국가예방접종 지원사업 지정 의료기관으로, 보건소를 따로 방문하지 않아도 본원에서 대상자 기준 무료로 인플루엔자, 폐렴구균, HPV, 코로나19 등을 접종받으실 수 있습니다. 지원 대상과 기간은 매년 질병관리청 기준에 따라 달라지므로, 접종 전 031-979-0875로 확인하시기 바랍니다.</p></div></div>
          </div>
          <div class="eum_item">
            <button class="eum_qbtn" type="button" aria-expanded="false"><span class="eum_qm">Q</span><span class="eum_qt">독감 예방접종은 언제 맞아야 하나요?</span><span class="eum_sign"></span></button>
            <div class="eum_abox"><div class="eum_ain"><p>인플루엔자 예방접종은 유행 전인 10월~11월에 맞는 것이 가장 좋습니다. 접종 후 항체 형성에 약 2주가 걸리고 효과가 한 절기 유지되므로 매년 다시 접종해야 합니다. 시기를 놓쳤더라도 유행 기간 중에는 접종이 권장되며, 만성질환자·65세 이상·임신부는 우선 접종 대상입니다.</p></div></div>
          </div>
          <div class="eum_item">
            <button class="eum_qbtn" type="button" aria-expanded="false"><span class="eum_qm">Q</span><span class="eum_qt">코로나19 예방접종도 하나요?</span><span class="eum_sign"></span></button>
            <div class="eum_abox"><div class="eum_ain"><p>네, 이움내과의원은 국가예방접종 지원사업 지정 의료기관으로 코로나19 예방접종을 시행합니다. 접종 대상과 시기는 질병관리청 기준에 따라 매년 달라지므로, 접종 가능 시기와 대상 여부는 031-979-0875로 문의하시기 바랍니다. 65세 이상 고령자와 만성질환자, 면역저하자는 우선 접종 대상입니다.</p></div></div>
          </div>
        </div>
      </div>

      <!-- 분류 2 : 폐렴구균 · 캡박시브 상세 안내 -->
      <div class="eum_group">
        <div class="eum_qa">
          <div class="eum_item">
            <button class="eum_qbtn" type="button" aria-expanded="false"><span class="eum_qm">Q</span><span class="eum_qt">폐렴구균 백신, 예전처럼 두 번 맞아야 하나요?</span><span class="eum_sign"></span></button>
            <div class="eum_abox"><div class="eum_ain"><p>아닙니다. 대한감염학회 개정 권고안(2026년 5월)에 따르면, 21가 폐렴구균 단백접합백신(PCV21)은 1회 접종으로 완료할 수 있습니다. 기존에는 단백접합백신(PCV15) 접종 후 다당질백신(PPSV23)을 추가로 맞는 2회 접종 방식이 필요했으나, PCV21 또는 PCV20은 1회 접종만으로 권고 기준을 충족합니다. 이움내과의원은 PCV21(캡박시브)을 갖추고 있어 한 번의 접종으로 폐렴구균 예방접종을 마칠 수 있습니다.</p></div></div>
          </div>
          <div class="eum_item">
            <button class="eum_qbtn" type="button" aria-expanded="false"><span class="eum_qm">Q</span><span class="eum_qt">캡박시브(21가 폐렴구균 백신)는 어떤 백신인가요?</span><span class="eum_sign"></span></button>
            <div class="eum_abox"><div class="eum_ain"><p>캡박시브는 성인 전용으로 설계된 21가 폐렴구균 단백접합백신(PCV21)으로, 만 18세 이상 성인에서 1회 접종합니다. 2025년 8월 식품의약품안전처 허가를 받아 2026년 3월 국내에 출시되었으며, 대한감염학회는 2026년 5월 개정 권고안에 65세 이상 성인과 19~64세 고위험군의 접종 옵션으로 PCV21을 포함했습니다. 기존 백신에 없던 8개 혈청형을 포함해 성인에서 문제가 되는 혈청형을 반영한 것이 특징입니다.</p></div></div>
          </div>
          <div class="eum_item">
            <button class="eum_qbtn" type="button" aria-expanded="false"><span class="eum_qm">Q</span><span class="eum_qt">이미 폐렴구균 백신을 맞았는데 캡박시브를 또 맞아도 되나요?</span><span class="eum_sign"></span></button>
            <div class="eum_abox"><div class="eum_ain"><p>네, 가능합니다. 이전에 다당질백신(PPSV23)이나 13가 단백접합백신(PCV13)을 접종한 경우에도 PCV21 접종이 권장될 수 있으며, 접종 시기와 필요 여부는 이전 접종 종류·시점·기저질환에 따라 달라집니다. 접종 기록을 확인해 개인에게 맞는 일정을 판단하므로, 진료 시 이전 접종 이력을 알려 주십시오.</p></div></div>
          </div>
        </div>
      </div>

      <!-- 분류 3 : 대상포진 · HPV -->
      <div class="eum_group">
        <div class="eum_qa">
          <div class="eum_item">
            <button class="eum_qbtn" type="button" aria-expanded="false"><span class="eum_qm">Q</span><span class="eum_qt">대상포진 예방접종은 누가 맞아야 하나요?</span><span class="eum_sign"></span></button>
            <div class="eum_abox"><div class="eum_ain"><p>대상포진 백신은 만 50세 이상에게 권장되며, 나이가 들수록 발생 위험과 신경통 합병증이 커집니다. 만성질환자나 면역저하자는 위험이 더 높아 접종의 이득이 큽니다. 백신 종류와 접종 방식, 기저질환에 따른 적합성은 진료 시 상담해 결정합니다.</p></div></div>
          </div>
          <div class="eum_item">
            <button class="eum_qbtn" type="button" aria-expanded="false"><span class="eum_qm">Q</span><span class="eum_qt">대상포진 백신은 어떤 걸 맞는 게 좋을까요?</span><span class="eum_sign"></span></button>
            <div class="eum_abox"><div class="eum_ain"><p>대한감염학회는 50세 이상에서 싱그릭스(재조합백신)를 우선 권고하며, 예방효과가 90% 이상으로 높고 오래 지속됩니다. 스카이조스터는 1회 접종으로 간편하지만 생백신이라 면역저하자에게는 부적합합니다. 본원은 두 백신을 모두 보유하고 있어 상담 후 선택하실 수 있습니다.</p></div></div>
          </div>
          <div class="eum_item">
            <button class="eum_qbtn" type="button" aria-expanded="false"><span class="eum_qm">Q</span><span class="eum_qt">가다실 9가(HPV) 접종도 가능한가요?</span><span class="eum_sign"></span></button>
            <div class="eum_abox"><div class="eum_ain"><p>네, 이움내과의원에서 사람유두종바이러스(HPV) 9가 백신(가다실 9가) 접종이 가능합니다. HPV 백신은 자궁경부암을 비롯한 HPV 관련 질환 예방을 위해 접종하며, 만 12세 여성 청소년은 국가예방접종 지원 대상입니다. 성인 접종 대상과 접종 횟수(연령에 따라 2회 또는 3회)는 진료 시 안내해 드립니다.</p></div></div>
          </div>
          <div class="eum_item">
            <button class="eum_qbtn" type="button" aria-expanded="false"><span class="eum_qm">Q</span><span class="eum_qt">HPV 백신, 남자도 꼭 맞아야 하나요?</span><span class="eum_sign"></span></button>
            <div class="eum_abox"><div class="eum_ain"><p>HPV는 성 접촉으로 남녀 모두 감염되는 바이러스입니다. 남성도 항문암·음경암·구인두암·생식기사마귀 등을 예방할 수 있고, 파트너에게 전파를 막는 의미도 있어 WHO와 미국 CDC도 남성 접종을 표준으로 권고합니다.</p></div></div>
          </div>
        </div>
      </div>

      <!-- 분류 4 : 간염 등 성인 접종 -->
      <div class="eum_group">
        <div class="eum_qa">
          <div class="eum_item">
            <button class="eum_qbtn" type="button" aria-expanded="false"><span class="eum_qm">Q</span><span class="eum_qt">A형간염 예방접종은 누가 맞아야 하나요?</span><span class="eum_sign"></span></button>
            <div class="eum_abox"><div class="eum_ain"><p>A형간염 백신은 항체가 없는 20~40대 성인, 만성 간질환자, 단체생활을 하는 분에게 특히 권장되며 6~18개월 간격으로 총 2회 접종합니다. 우리나라 30~40대는 A형간염 항체 보유율이 낮아 감염 시 증상이 심한 경우가 많습니다. 접종 전 항체검사를 시행할 수 있으므로 진료 시 상담하십시오.</p></div></div>
          </div>
          <div class="eum_item">
            <button class="eum_qbtn" type="button" aria-expanded="false"><span class="eum_qm">Q</span><span class="eum_qt">B형간염 예방접종은 어떻게 하나요?</span><span class="eum_sign"></span></button>
            <div class="eum_abox"><div class="eum_ain"><p>B형간염 백신은 항체가 없는 성인에게 0·1·6개월 일정으로 총 3회 접종하며, 접종 전후 항원·항체 검사로 필요 여부와 항체 형성을 확인합니다. 만성콩팥병·투석 환자는 항체 형성이 잘 되지 않아 접종 용량이나 횟수를 조정하는 경우가 있어, 투석 환자는 진료를 통해 일정을 정합니다.</p></div></div>
          </div>
        </div>
      </div>

      <!-- 분류 5 : 동반질환자 접종 안내 -->
      <div class="eum_group">
        <div class="eum_qa">
          <div class="eum_item">
            <button class="eum_qbtn" type="button" aria-expanded="false"><span class="eum_qm">Q</span><span class="eum_qt">65세 이상 폐렴구균 접종은 무료인가요?</span><span class="eum_sign"></span></button>
            <div class="eum_abox"><div class="eum_ain"><p>만 65세 이상 국가지원 대상 폐렴구균 백신은 23가 다당질백신(PPSV23)이며, 이움내과의원은 국가예방접종 지정 의료기관으로 지원 기준에 따라 접종을 시행합니다. 21가 단백접합백신(PCV21, 캡박시브)은 국가지원 대상이 아니어서 본인 부담입니다. 어떤 백신이 적합한지는 나이·기저질환·이전 접종력에 따라 다르므로 진료 시 상담하십시오.</p></div></div>
          </div>
          <div class="eum_item">
            <button class="eum_qbtn" type="button" aria-expanded="false"><span class="eum_qm">Q</span><span class="eum_qt">투석 환자도 예방접종을 맞아야 하나요?</span><span class="eum_sign"></span></button>
            <div class="eum_abox"><div class="eum_ain"><p>네, 만성콩팥병과 투석 환자는 면역력이 저하되어 감염 위험이 높으므로 예방접종이 특히 중요합니다. 인플루엔자(매년), 폐렴구균, B형간염 접종이 권장되며, 투석 환자는 B형간염 항체 형성이 잘 되지 않아 별도의 접종 일정이 필요한 경우가 있습니다. 이움내과의원에서 투석 중인 환자는 진료 시 필요한 접종을 함께 관리받을 수 있습니다.</p></div></div>
          </div>
          <div class="eum_item">
            <button class="eum_qbtn" type="button" aria-expanded="false"><span class="eum_qm">Q</span><span class="eum_qt">당뇨병 환자는 어떤 예방접종이 필요한가요?</span><span class="eum_sign"></span></button>
            <div class="eum_abox"><div class="eum_ain"><p>당뇨병 환자는 인플루엔자(매년), 폐렴구균, B형간염 접종이 권장됩니다. 당뇨병은 감염 저항력을 떨어뜨리고 감염 시 혈당 조절을 어렵게 만들기 때문에, 예방접종은 합병증 관리의 일부입니다. 정기 진료 시 접종 이력을 확인해 필요한 백신을 안내해 드립니다.</p></div></div>
          </div>
        </div>
      </div>

      <!-- 분류 6 : 접종 전후 안내 -->
      <div class="eum_group">
        <div class="eum_qa">
          <div class="eum_item">
            <button class="eum_qbtn" type="button" aria-expanded="false"><span class="eum_qm">Q</span><span class="eum_qt">감기에 걸렸는데 예방접종을 맞아도 되나요?</span><span class="eum_sign"></span></button>
            <div class="eum_abox"><div class="eum_ain"><p>가벼운 감기 증상이 있어도 열이 없다면 대부분 접종이 가능하지만, 38도 이상의 발열이나 급성 질환을 앓는 중에는 회복 후로 미루는 것이 원칙입니다. 접종 당일 컨디션을 진료로 확인한 뒤 시행 여부를 판단하므로 몸 상태를 알려 주십시오.</p></div></div>
          </div>
          <div class="eum_item">
            <button class="eum_qbtn" type="button" aria-expanded="false"><span class="eum_qm">Q</span><span class="eum_qt">예방접종 후 주의할 점은 무엇인가요?</span><span class="eum_sign"></span></button>
            <div class="eum_abox"><div class="eum_ain"><p>접종 후 접종 부위 통증·붓기, 미열, 근육통이 나타날 수 있으며 대부분 2~3일 내 사라집니다. 접종 후 20~30분간 병원이나 근처에 머물며 급성 이상반응을 관찰하는 것이 안전합니다. 고열이 지속되거나 호흡곤란·심한 두드러기가 나타나면 즉시 진료를 받으십시오. 접종 당일은 과격한 운동과 음주를 피하십시오.</p></div></div>
          </div>
        </div>
      </div>
    </div>
  </section>

